diff --git a/dlls/shlwapi/ordinal.c b/dlls/shlwapi/ordinal.c
index 4a00c6f..11e43e0 100644
--- a/dlls/shlwapi/ordinal.c
+++ b/dlls/shlwapi/ordinal.c
@@ -4568,3 +4568,47 @@ DWORD WINAPI SHGetObjectCompatFlags(IUnknown *pUnk, const CLSID *clsid)
 
     return ret;
 }
+
+/* Shell global counters identified by SHGLOBALCOUNTER (Vista+; the older ordinals 223, 224 and
+ * 424 take a semaphore handle instead). Windows keeps them in named semaphores shared by all
+ * processes of the session; this implementation keeps them per process. */
+static LONG global_counters[64];
+
+static LONG *get_global_counter(int id)
+{
+    if (id < 0 || id >= ARRAY_SIZE(global_counters)) return NULL;
+    return &global_counters[id];
+}
+
+/*************************************************************************
+ *      @	[SHLWAPI.632]
+ */
+LONG WINAPI SHGlobalCounterGetValue_Vista(int id)
+{
+    LONG *counter = get_global_counter(id);
+
+    TRACE("(%d)\n", id);
+    return counter ? ReadNoFence(counter) : 0;
+}
+
+/*************************************************************************
+ *      @	[SHLWAPI.633]
+ */
+LONG WINAPI SHGlobalCounterIncrement_Vista(int id)
+{
+    LONG *counter = get_global_counter(id);
+
+    TRACE("(%d)\n", id);
+    return counter ? InterlockedIncrement(counter) : 0;
+}
+
+/*************************************************************************
+ *      @	[SHLWAPI.634]
+ */
+LONG WINAPI SHGlobalCounterDecrement_Vista(int id)
+{
+    LONG *counter = get_global_counter(id);
+
+    TRACE("(%d)\n", id);
+    return counter ? InterlockedDecrement(counter) : 0;
+}
