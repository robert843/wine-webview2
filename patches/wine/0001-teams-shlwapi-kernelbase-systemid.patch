+/***********************************************************************
+ *         FindPackagesByPackageFamily   (kernelbase.@)
+ */
+LONG WINAPI FindPackagesByPackageFamily(const WCHAR *family_name, UINT32 flags, UINT32 *count,
+                                        WCHAR **full_names, UINT32 *buffer_len, WCHAR *buffer, UINT32 *properties)
+{
+    FIXME( "(%s %#x %p %p %p %p %p): stub\n", debugstr_w(family_name), flags, count, full_names, buffer_len,
+           buffer, properties );
+
+    if (!family_name || !count || !buffer_len)
+        return ERROR_INVALID_PARAMETER;
+
+    /* No package deployment: no package of any family is installed. */
+    *count = 0;
+    *buffer_len = 0;
+    return ERROR_SUCCESS;
+}
